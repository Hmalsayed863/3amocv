<script>
  // Mobile nav toggle
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  navToggle.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    navToggle.setAttribute('aria-expanded', 'false');
  }));

  // Path draw-on-scroll: fill the vertical line and reveal nodes as the section enters view
  const paths = document.querySelectorAll('[data-path]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function activatePath(pathEl){
    const fill = pathEl.querySelector('[data-fill]');
    const nodes = pathEl.querySelectorAll('[data-node]');
    if(reduceMotion){
      fill.style.height = '100%';
      nodes.forEach(n => n.classList.add('on'));
      return;
    }
    fill.style.height = '100%';
    nodes.forEach((n, i) => {
      setTimeout(() => n.classList.add('on'), 150 * i + 200);
    });
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        activatePath(entry.target);
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.35 });

  paths.forEach(p => io.observe(p));
</script>

