<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>المهندس المستشار عصام بشاره | مرشح لمجلس إدارة أشرقت</title>
<meta name="description" content="الملف الانتخابي للمهندس المستشار عصام بن حسن احمد بشاره، مرشح المقعد 105 لمجلس إدارة شركة مطوفي حجاج الدول العربية (أشرقت).">
<meta name="theme-color" content="#0D3733">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --pine-900:#0D3733;
    --pine-800:#11413B;
    --pine-700:#155249;
    --gold-500:#C6963C;
    --gold-300:#E4C77E;
    --gold-100:#F1E4C3;
    --sand-50:#F8F3E7;
    --sand-100:#EFE6CE;
    --copper-600:#A85C32;
    --copper-700:#8E4B27;
    --ink-900:#191F1C;
    --ink-600:#4B564E;
    --line:#DCCDA4;
    --radius-s:6px;
    --radius-m:10px;
    --shadow-1: 0 10px 30px -12px rgba(13,55,51,0.35);
    --maxw:1180px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--sand-50);
    color:var(--ink-900);
    font-family:'Almarai', sans-serif;
    font-weight:400;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4,.display{
    font-family:'Cairo', sans-serif;
    margin:0;
    color:var(--pine-900);
    line-height:1.25;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:'Cairo', sans-serif;
    font-weight:700;
    font-size:0.95rem;
    color:var(--copper-700);
    margin-bottom:14px;
  }
  .eyebrow::before{
    content:"";
    width:22px;height:2px;
    background:var(--copper-600);
    display:inline-block;
  }
  section{padding:96px 0;}
  @media (max-width:720px){ section{padding:64px 0;} }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }

  /* ---------- Header ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(13,55,51,0.94);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(198,150,60,0.35);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 28px;
    max-width:var(--maxw); margin:0 auto;
  }
  .brand{display:flex; align-items:center; gap:12px; color:var(--sand-50); text-decoration:none;}
  .brand-badge{
    width:40px;height:40px; flex:none;
    border:2px solid var(--gold-500);
    display:flex;align-items:center;justify-content:center;
    font-family:'Cairo', sans-serif; font-weight:800; color:var(--gold-300);
    clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    font-size:0.95rem;
  }
  .brand-text b{display:block; font-family:'Cairo',sans-serif; font-weight:800; font-size:1rem;}
  .brand-text span{display:block; font-size:0.78rem; color:var(--gold-300);}
  nav.links{display:flex; gap:28px; align-items:center;}
  nav.links a{
    color:var(--sand-100); text-decoration:none; font-weight:700; font-size:0.95rem;
    font-family:'Cairo', sans-serif;
    padding:6px 2px; border-bottom:2px solid transparent;
    transition:border-color .2s ease, color .2s ease;
  }
  nav.links a:hover, nav.links a:focus-visible{ color:var(--gold-300); border-color:var(--gold-500); }
  .nav-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--copper-600); color:#fff !important;
    font-family:'Cairo',sans-serif; font-weight:700; font-size:0.9rem;
    padding:10px 18px; text-decoration:none;
    border-radius:var(--radius-s);
    transition:background .2s ease, transform .2s ease;
  }
  .nav-cta:hover{ background:var(--copper-700); transform:translateY(-1px); }
  .nav-toggle{display:none;}

  @media (max-width:900px){
    nav.links{
      position:absolute; inset-inline:0; top:100%;
      background:var(--pine-900); flex-direction:column; align-items:flex-start;
      padding:18px 28px; gap:16px;
      border-bottom:1px solid rgba(198,150,60,0.35);
      display:none;
    }
    nav.links.open{display:flex;}
    .nav-toggle{
      display:inline-flex; align-items:center; justify-content:center;
      width:40px;height:40px; background:transparent; border:1px solid var(--gold-500);
      border-radius:var(--radius-s); color:var(--gold-300); cursor:pointer;
    }
    .nav-cta{display:none;}
  }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    background:linear-gradient(180deg, var(--pine-900) 0%, var(--pine-800) 62%, var(--pine-700) 100%);
    color:var(--sand-50);
    overflow:hidden;
    padding-top:72px;
  }
  .hero .wrap{
    display:grid;
    grid-template-columns:1.15fr 0.85fr;
    gap:48px;
    align-items:center;
    padding-top:56px;
    padding-bottom:40px;
    position:relative;
    z-index:2;
  }
  @media (max-width:900px){
    .hero .wrap{grid-template-columns:1fr; padding-top:32px;}
    .hero .portrait-col{order:-1; max-width:280px; margin:0 auto;}
  }
  .hero-eyebrow{
    font-family:'Cairo',sans-serif; font-weight:700; font-size:0.98rem;
    color:var(--gold-300); display:flex; align-items:center; gap:10px; margin-bottom:18px;
  }
  .hero-eyebrow::before{content:"";width:22px;height:2px;background:var(--gold-500);}
  .hero h1{
    font-size:clamp(2rem, 4vw, 3.1rem);
    font-weight:900;
    color:#fff;
    margin-bottom:18px;
  }
  .hero .slogan{
    font-family:'Cairo',sans-serif; font-weight:700; font-size:1.15rem;
    color:var(--gold-300); margin-bottom:16px;
  }
  .hero p.lede{
    font-size:1.05rem; color:var(--sand-100); max-width:52ch; margin-bottom:30px;
  }
  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:44px;}
  .btn{
    font-family:'Cairo',sans-serif; font-weight:700; font-size:0.98rem;
    padding:14px 26px; text-decoration:none; display:inline-flex; align-items:center; gap:10px;
    border-radius:var(--radius-s); transition:transform .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .btn-primary{ background:var(--copper-600); color:#fff; }
  .btn-primary:hover{ background:var(--copper-700); transform:translateY(-2px); box-shadow:var(--shadow-1); }
  .btn-ghost{ border:1.5px solid var(--gold-500); color:var(--gold-300); }
  .btn-ghost:hover{ background:rgba(198,150,60,0.12); transform:translateY(-2px); }

  .stat-strip{
    display:flex; gap:0; border-top:1px solid rgba(228,199,126,0.3);
    padding-top:26px; flex-wrap:wrap;
  }
  .stat-strip .stat{
    padding:0 28px; border-inline-end:1px solid rgba(228,199,126,0.3);
  }
  .stat-strip .stat:first-child{padding-inline-start:0;}
  .stat-strip .stat:last-child{border-inline-end:none;}
  .stat b{
    display:block; font-family:'Cairo',sans-serif; font-weight:900; font-size:1.9rem; color:var(--gold-300);
  }
  .stat span{font-size:0.85rem; color:var(--sand-100);}

  .portrait-col{position:relative;}
  .portrait-frame{
    position:relative;
    width:100%;
    aspect-ratio:520/576;
    clip-path:polygon(50% 0%, 100% 20%, 100% 78%, 50% 100%, 0% 78%, 0% 20%);
    background:linear-gradient(160deg, var(--gold-500), var(--gold-300) 45%, var(--gold-500));
    padding:5px;
  }
  .portrait-frame img{
    width:100%; height:100%; object-fit:cover;
    clip-path:polygon(50% 0%, 100% 20%, 100% 78%, 50% 100%, 0% 78%, 0% 20%);
    background:var(--pine-700);
  }
  .seat-badge{
    position:absolute; bottom:-18px; right:50%; transform:translateX(50%);
    background:var(--pine-900); border:2px solid var(--gold-500);
    color:var(--gold-300); font-family:'Cairo',sans-serif; font-weight:900;
    width:76px;height:76px; border-radius:50%;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-size:1.6rem; line-height:1;
    box-shadow:var(--shadow-1);
  }
  .seat-badge small{font-family:'Cairo',sans-serif; font-weight:700; font-size:0.6rem; color:var(--sand-100); margin-top:2px;}

  .hero-mountains{
    position:absolute; inset-inline:0; bottom:0; z-index:1; opacity:0.5; pointer-events:none;
  }

  /* fade-in on load, single orchestrated moment */
  .hero-anim > *{
    opacity:0; transform:translateY(14px);
    animation:heroIn .7s ease forwards;
  }
  .hero-anim > *:nth-child(1){animation-delay:.05s;}
  .hero-anim > *:nth-child(2){animation-delay:.15s;}
  .hero-anim > *:nth-child(3){animation-delay:.25s;}
  .hero-anim > *:nth-child(4){animation-delay:.35s;}
  .hero-anim > *:nth-child(5){animation-delay:.45s;}
  .hero-anim > *:nth-child(6){animation-delay:.55s;}
  @keyframes heroIn{ to{opacity:1; transform:translateY(0);} }

  /* ---------- Vision section ---------- */
  .vision{background:var(--sand-50);}
  .vision .wrap{
    display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; align-items:start;
  }
  @media (max-width:820px){ .vision .wrap{grid-template-columns:1fr; gap:28px;} }
  .vision h2{font-size:clamp(1.6rem,3vw,2.2rem); font-weight:800; margin-bottom:10px;}
  .vision .lede{color:var(--ink-600); font-size:1.05rem; max-width:40ch;}
  .vision-card{
    background:#fff; border:1px solid var(--line); border-inline-start:4px solid var(--gold-500);
    border-radius:var(--radius-s); padding:26px 28px; margin-bottom:18px;
  }
  .vision-card h3{font-size:1.05rem; font-weight:800; margin-bottom:8px;}
  .vision-card p{color:var(--ink-600); margin:0;}

  /* ---------- Tracks section ---------- */
  .tracks{background:var(--sand-100);}
  .tracks-head{max-width:60ch; margin-bottom:56px;}
  .tracks-head h2{font-size:clamp(1.6rem,3vw,2.2rem); font-weight:800; margin-bottom:12px;}
  .tracks-head p{color:var(--ink-600);}
  .tracks-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:48px;
  }
  @media (max-width:820px){ .tracks-grid{grid-template-columns:1fr;} }
  .track h3{
    font-family:'Cairo',sans-serif; font-weight:800; font-size:1.2rem;
    color:var(--pine-900); margin-bottom:6px;
  }
  .track .track-count{
    font-size:0.88rem; color:var(--copper-700); font-weight:700; margin-bottom:28px; display:block;
  }
  .path{ position:relative; padding-inline-start:36px; }
  .path::before{
    content:"";
    position:absolute; inset-inline-start:11px; top:6px; bottom:6px;
    width:2px; background:var(--line);
  }
  .path .path-line-fill{
    position:absolute; inset-inline-start:11px; top:6px; width:2px; height:0;
    background:var(--gold-500);
    transition:height 1.1s ease;
  }
  .node{position:relative; padding-bottom:30px;}
  .node:last-child{padding-bottom:0;}
  .node::before{
    content:""; position:absolute; inset-inline-start:-36px; top:2px;
    width:24px;height:24px; border-radius:50%;
    background:var(--sand-100); border:2px solid var(--line);
    transition:border-color .4s ease, background .4s ease;
  }
  .node.on::before{ border-color:var(--gold-500); background:var(--gold-100); }
  .node h4{font-size:1rem; font-weight:800; color:var(--ink-900); margin-bottom:4px;}
  .node p{margin:0; color:var(--ink-600); font-size:0.95rem;}

  /* ---------- Candidacy / numbers ---------- */
  .candidacy{background:var(--pine-900); color:var(--sand-50);}
  .candidacy .wrap{
    display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;
  }
  @media (max-width:820px){ .candidacy .wrap{grid-template-columns:1fr;} }
  .candidacy h2{color:#fff; font-size:clamp(1.5rem,3vw,2rem); font-weight:800; margin-bottom:16px;}
  .candidacy p{color:var(--sand-100); max-width:46ch;}
  .ballot-card{
    background:var(--pine-800); border:1px solid rgba(228,199,126,0.35);
    border-radius:var(--radius-m); padding:32px; text-align:center;
  }
  .ballot-num{
    font-family:'Cairo',sans-serif; font-weight:900; font-size:4.2rem; color:var(--gold-300); line-height:1;
  }
  .ballot-card .ballot-label{font-family:'Cairo',sans-serif; font-weight:700; color:var(--sand-100); margin-top:8px; display:block;}
  .ballot-card .ballot-sub{
    margin-top:18px; padding-top:18px; border-top:1px solid rgba(228,199,126,0.25);
    font-size:0.95rem; color:var(--sand-100);
  }

  /* ---------- Contact ---------- */
  .contact{background:var(--sand-50);}
  .contact .wrap{ max-width:760px; }
  .contact h2{font-size:clamp(1.6rem,3vw,2.2rem); font-weight:800; margin-bottom:12px;}
  .contact p.lede{color:var(--ink-600); max-width:52ch; margin-bottom:26px;}
  .contact-info{list-style:none; margin:0; padding:0;}
  .contact-info li{
    display:flex; align-items:center; gap:14px; padding:14px 0; border-bottom:1px solid var(--line);
    font-family:'Cairo',sans-serif; font-weight:700;
  }
  .contact-info li:last-child{border-bottom:none;}
  .contact-info .ic{
    width:38px;height:38px; flex:none; border:1.5px solid var(--gold-500); color:var(--copper-700);
    display:flex; align-items:center; justify-content:center; border-radius:50%;
  }


  /* ---------- Footer ---------- */
  footer{background:var(--pine-900); color:var(--sand-100); padding:52px 0 28px;}
  footer .wrap{
    display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap;
    border-bottom:1px solid rgba(228,199,126,0.25); padding-bottom:32px; margin-bottom:20px;
  }
  footer .who b{display:block; font-family:'Cairo',sans-serif; font-weight:800; color:#fff; font-size:1.1rem;}
  footer .who span{display:block; font-size:0.9rem; margin-top:4px;}
  footer .tagline{
    font-family:'Cairo',sans-serif; font-weight:800; color:var(--gold-300); font-size:1.15rem; align-self:center;
  }
  footer .fine{
    max-width:var(--maxw); margin:0 auto; padding:0 28px;
    font-size:0.82rem; color:var(--sand-100); opacity:0.75;
  }

  .visually-hidden{
    position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;
  }

  a:focus-visible, button:focus-visible{
    outline:2px solid var(--gold-500); outline-offset:2px;
  }
</style>
</head>
